<Window x:Class="W221Diag.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="W221Diag" Height="620" Width="980" MinHeight="540" MinWidth="860">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="W221Diag" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Mercedes-Benz W221 / TEXA TXT Multihub - Wi-Fi analysis mode" FontSize="14" Margin="0,4,0,12"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TargetIpBox" Grid.Column="0" Height="36" VerticalContentAlignment="Center" Margin="0,0,8,0"
                     ToolTip="IP adresa Multihubu. Môže zostať prázdna a použiť Vyhľadať zariadenia."/>
            <Button x:Name="DiscoverButton" Grid.Column="1" Content="Vyhľadať zariadenia" Padding="16,7" Margin="0,0,8,0" Click="DiscoverButton_Click"/>
            <Button x:Name="StartCaptureButton" Grid.Column="2" Content="Spustiť záznam" Padding="16,7" Margin="0,0,8,0" Click="StartCaptureButton_Click"/>
            <Button x:Name="StopCaptureButton" Grid.Column="3" Content="Zastaviť a exportovať" Padding="16,7" Click="StopCaptureButton_Click" IsEnabled="False"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Nájdené zariadenia" Grid.Column="0" Margin="0,0,8,0">
                <ListView x:Name="HostsList" SelectionChanged="HostsList_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="IP" DisplayMemberBinding="{Binding Ip}" Width="130"/>
                            <GridViewColumn Header="Názov" DisplayMemberBinding="{Binding HostName}" Width="180"/>
                            <GridViewColumn Header="Odozva" DisplayMemberBinding="{Binding Latency}" Width="80"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>

            <GroupBox Header="Stav / protokol" Grid.Column="1" Margin="8,0,0,0">
                <TextBox x:Name="LogBox" FontFamily="Consolas" FontSize="13" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"/>
            </GroupBox>
        </Grid>

        <TextBlock Grid.Row="3" Margin="0,12,0,0" Text="Bezpečný režim: aplikácia zatiaľ iba zisťuje sieť a zaznamenáva komunikáciu. Do vozidla nič nezapisuje."/>
    </Grid>
</Window>
